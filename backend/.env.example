# --- Gemini (siempre requerido: analiza la escena y refina el prompt) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenAI (opcional: solo si eliges el modelo "GPT / gpt-image-1" en la app) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- fal.ai / FLUX Kontext (opcional: solo si eliges "FLUX Kontext" en la app) ---
# Consíguela en https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# --- Server ---
PORT=8080
# URL del frontend permitida por CORS (en local: http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
