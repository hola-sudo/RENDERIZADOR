# --- Gemini (único proveedor de IA: análisis de escena, prompt, render y video) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Replicate (upscaling de video, proceso aparte) ---
# Token en https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxx
# Opcionales: modelo y fps de salida del upscaler (default: Topaz a 24 fps, la cadencia de Veo)
# REPLICATE_UPSCALE_MODEL=topazlabs/video-upscale
# REPLICATE_UPSCALE_FPS=24

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# --- Server ---
PORT=8080
# URL del frontend permitida por CORS (en local: http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
