# Copia este archivo a .env.local y rellena los valores.
# Solo las variables con prefijo VITE_ quedan expuestas al navegador.

# Supabase (Project Settings > API) — valores públicos
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Backend (Render Web Service). En local: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
